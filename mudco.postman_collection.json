      "name": "4. Pemilik: laporan & stok",
      "item": [
        {
          "name": "Laporan hari ini",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('today', new Date().toLocaleDateString('sv-SE'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('laba = omzet - HPP', () => pm.expect(r.estimatedProfit).to.eql(r.totalRevenue - r.totalCost));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pemilikToken}}"
              }
            ],
            "url": "{{baseUrl}}/report?from={{today}}&to={{today}}"
          }
